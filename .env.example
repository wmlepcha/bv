APP_NAME="Bilingual Vitae"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Local Herd secure: APP_URL=https://your-site.test (after `herd secure your-site`)
# Production: set APP_ENV=production, APP_DEBUG=false, APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production: LOG_LEVEL=warning or error

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Production (HTTPS): SESSION_SECURE_COOKIE=true
# Optional hardening: SESSION_ENCRYPT=true, SESSION_SAME_SITE=lax
# SESSION_SECURE_COOKIE=
# SESSION_HTTP_ONLY=true
# SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Local/dev default. Production: keep database + Hostinger cron every minute:
#   cd /home/u235343772/domains/bilingualvitae.com/public_html && /usr/bin/php artisan queue:work --stop-when-empty
# Without that cron, queued emails never send until someone runs queue:work by hand.
# Smoke-test alternative: QUEUE_CONNECTION=sync (sends inside the HTTP request).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local: log writes to storage/logs (no real email).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@bilingualvitae.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_OPS_ADDRESS="hello@bilingualvitae.com"

# Production (required for real delivery):
# MAIL_MAILER=resend
# RESEND_API_KEY=
# APP_URL=https://bilingualvitae.com
# Verify: php artisan tinker --execute="dump(DB::table('jobs')->count(), DB::table('failed_jobs')->count());"


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Inertia SSR (disabled by default; enable only if running php artisan inertia:start-ssr)
INERTIA_SSR_ENABLED=false
# INERTIA_SSR_URL=http://127.0.0.1:13714

CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENVIRONMENT=production
CASHFREE_API_VERSION=2023-08-01
CASHFREE_CURRENCY=INR
REGISTRATION_FEE_AMOUNT=100

# DeepL API (CV German translation). Free/Developer keys ending in :fx use api-free.deepl.com
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com

# PASSKEYS_USER_HANDLE_SECRET=
